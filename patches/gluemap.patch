+    def _inject_extra_pairs(
+        self,
+        args: argparse.Namespace,
+        pairs: np.ndarray,
+    ) -> np.ndarray:
+        """Union forced pairs from ``args.extra_pairs_path`` into ``pairs``.
+
+        Global descriptors cannot retrieve a forward<->reverse match: the two
+        traversals of a corridor look nothing alike, so VPR never proposes the
+        pair and the two sequences can never be linked. This lets a caller force
+        those pairs in as CANDIDATES; two-view geometry and Doppelgangers still
+        decide whether any of them survive.
+
+        The file holds one ``nameA nameB`` per line, names relative to
+        ``images_path`` and matching ``self.images_list`` entries exactly. An
+        unmatched name is a hard error: a silently dropped bridge is precisely
+        the failure this option exists to prevent.
+
+        Args:
+            args: Namespace; reads optional ``extra_pairs_path``.
+            pairs: (N, 2) undirected unique pairs from retrieval.
+
+        Returns:
+            (M, 2) int64 array, ``i < j``, deduplicated.
+        """
+        path = getattr(args, "extra_pairs_path", None)
+        if not path:
+            return pairs
+
+        index_of = {
+            Path(name).as_posix(): i
+            for i, name in enumerate(self.images_list)
+        }
+        forced, missing = [], []
+        with open(path) as f:
+            for lineno, line in enumerate(f, 1):
+                line = line.strip()
+                if not line or line.startswith("#"):
+                    continue
+                parts = line.split()
+                if len(parts) != 2:
+                    raise ValueError(
+                        f"{path}:{lineno}: expected 'nameA nameB', got {line!r}"
+                    )
+                a, b = (Path(name).as_posix() for name in parts)
+                if a not in index_of or b not in index_of:
+                    missing.append((lineno, a if a not in index_of else b))
+                    continue
+                i, j = index_of[a], index_of[b]
+                if i != j:
+                    forced.append((min(i, j), max(i, j)))
+
+        if missing:
+            preview = ", ".join(f"line {n}: {nm!r}" for n, nm in missing[:5])
+            raise ValueError(
+                f"{path}: {len(missing)} pair endpoint(s) not in the image "
+                "list "
+                f"({preview}). Names must be relative to images_path."
+            )
+
+        if not forced:
+            logger.warning(f"extra_pairs_path {path} yielded no usable pairs")
+            return pairs
+
+        forced_arr = np.asarray(sorted(set(forced)), dtype=np.int64)
+        before = len(pairs)
+        merged = np.unique(
+            np.concatenate([np.asarray(pairs, dtype=np.int64), forced_arr]),
+            axis=0,
+        )
+        logger.info(
+            f"Forced pairs: {len(forced_arr)} from {path}, "
+            f"{len(merged) - before} new after dedup "
+            f"(retrieval {before} -> total {len(merged)})"
+        )
+        return merged
