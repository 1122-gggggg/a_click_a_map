diff --git a/gluemap/estimators/roma_track_inference.py b/gluemap/estimators/roma_track_inference.py
new file mode 100644
index 0000000..d497e14
--- /dev/null
+++ b/gluemap/estimators/roma_track_inference.py
@@ -0,0 +1,181 @@
+"""Sparse multiview tracks from balanced RoMa v2 star-edge matches."""
+
+import math
+from collections import defaultdict
+
+import numpy as np
+import torch
+from PIL import Image
+
+from gluemap.estimators.track_inference import TrackInference
+from gluemap.math.scaling import standardize_query_points
+
+
+class _PixelAssociations:
+    """Associate to a fixed representative, without transitive pixel drift."""
+
+    def __init__(self, radius: float) -> None:
+        self.radius = radius
+        self.cells = defaultdict(list)
+
+    def _cell(self, point: np.ndarray) -> tuple[int, int]:
+        return tuple(math.floor(float(x) / self.radius) for x in point)
+
+    def find(self, point: np.ndarray) -> int | None:
+        x, y = self._cell(point)
+        nearest = None
+        distance = self.radius**2
+        for dx in (-1, 0, 1):
+            for dy in (-1, 0, 1):
+                for representative, index in self.cells.get((x + dx, y + dy), ()):
+                    squared_distance = float(((representative - point) ** 2).sum())
+                    if squared_distance <= distance:
+                        distance = squared_distance
+                        nearest = index
+        return nearest
+
+    def add(self, point: np.ndarray, index: int) -> None:
+        self.cells[self._cell(point)].append((point, index))
+
+
+class RoMaTrackInference:
+    """Match the center to each neighbor; only matched views are visible.
+
+    Matching uses original RGB images, not the padded VGGSfM 1024 canvas.
+    Pixel association is also in original-image pixels. Returned coordinates
+    are mapped into ``images_change`` space, exactly as for TrackInference;
+    the existing postprocessor restores originals before SIFT snapping.
+    ``vis`` and ``conf`` are overlap probabilities, not BA precision weights.
+    The official sampler's precision matrices are deliberately not forwarded:
+    the current augmented BA interface does not consume observation precision.
+    """
+
+    def __init__(
+        self,
+        model_track: torch.nn.Module | None,
+        device: str = "cuda",
+        max_matches: int = 1024,
+        center_radius: float = 1.0,
+    ) -> None:
+        if max_matches <= 0:
+            raise ValueError("RoMa max_matches must be positive")
+        if not math.isfinite(center_radius) or center_radius <= 0:
+            raise ValueError("RoMa center_radius must be finite and positive")
+        self.model_track = getattr(model_track, "module", model_track)
+        self.device = device
+        self.max_matches = max_matches
+        self.center_radius = center_radius
+
+    def _sample_edge(self, center: Image.Image, neighbor: Image.Image):
+        predictions = self.model_track.match(center, neighbor)
+        # RoMa's sampler draws 4 * num_corresp without replacement before
+        # density balancing. Bound that request even on low-overlap edges.
+        supported = 0
+        for direction in ("AB", "BA"):
+            warp = predictions.get(f"warp_{direction}")
+            if warp is None:
+                continue
+            overlap = torch.nan_to_num(
+                predictions[f"overlap_{direction}"], nan=0.0, posinf=0.0, neginf=0.0
+            ).clamp_(0.0, 1.0)
+            predictions[f"overlap_{direction}"] = overlap
+            inside = warp.abs().amax(dim=-1) <= 1 - 1 / warp.shape[1]
+            supported += int((inside & (overlap[..., 0] > 0)).sum().item())
+        sample_count = min(self.max_matches, supported // 4)
+        if sample_count == 0:
+            return np.empty((0, 2)), np.empty((0, 2)), np.empty(0)
+        matches, overlap, _, _ = self.model_track.sample(predictions, sample_count)
+        center_points, neighbor_points = self.model_track.to_pixel_coordinates(
+            matches, center.height, center.width, neighbor.height, neighbor.width
+        )
+        valid = (
+            torch.isfinite(center_points).all(dim=-1)
+            & torch.isfinite(neighbor_points).all(dim=-1)
+            & torch.isfinite(overlap)
+            & (overlap > 0.05)
+            & (center_points[:, 0] >= 0)
+            & (center_points[:, 0] < center.width)
+            & (center_points[:, 1] >= 0)
+            & (center_points[:, 1] < center.height)
+            & (neighbor_points[:, 0] >= 0)
+            & (neighbor_points[:, 0] < neighbor.width)
+            & (neighbor_points[:, 1] >= 0)
+            & (neighbor_points[:, 1] < neighbor.height)
+        )
+        return (
+            center_points[valid].float().cpu().numpy(),
+            neighbor_points[valid].float().cpu().numpy(),
+            overlap[valid].float().cpu().numpy(),
+        )
+
+    def _predict_star(self, paths: list[str]) -> list[dict]:
+        centers = _PixelAssociations(self.center_radius)
+        tracks = []
+        with Image.open(paths[0]) as source:
+            center = source.convert("RGB")
+        try:
+            for frame, path in enumerate(paths[1:], start=1):
+                with Image.open(path) as source:
+                    neighbor = source.convert("RGB")
+                try:
+                    points_a, points_b, overlaps = self._sample_edge(center, neighbor)
+                finally:
+                    neighbor.close()
+                neighbors = _PixelAssociations(self.center_radius)
+                # Sampling is spatially balanced. Confidence ordering only
+                # resolves duplicate/conflicting observations within that set.
+                for sample in np.argsort(-overlaps, kind="stable"):
+                    point_a, point_b = points_a[sample], points_b[sample]
+                    score = float(overlaps[sample])
+                    track_id = centers.find(point_a)
+                    if neighbors.find(point_b) is not None:
+                        continue
+                    if track_id is not None and frame in tracks[track_id]:
+                        continue
+                    if track_id is None:
+                        track_id = len(tracks)
+                        centers.add(point_a, track_id)
+                        tracks.append({0: (point_a, score)})
+                    else:
+                        anchor, previous = tracks[track_id][0]
+                        tracks[track_id][0] = (anchor, max(previous, score))
+                    tracks[track_id][frame] = (point_b, score)
+                    neighbors.add(point_b, track_id)
+        finally:
+            center.close()
+        return tracks
+
+    @torch.inference_mode()
+    def predict(
+        self,
+        batch: dict[str, torch.Tensor],
+        use_dummy_tracks: bool = False,
+    ) -> dict[str, torch.Tensor]:
+        if use_dummy_tracks:
+            return TrackInference(None, self.device).predict(batch, use_dummy_tracks=True)
+        if self.model_track is None:
+            raise ValueError("RoMa track inference requires a loaded RoMa v2 model")
+        batch_size, num_frames = batch["images"].shape[:2]
+        image_paths = batch["image_paths"]  # Default-collated: frame, then batch.
+        previous_precision = torch.get_float32_matmul_precision()
+        torch.set_float32_matmul_precision("highest")
+        try:
+            stars = [
+                self._predict_star([image_paths[j][i] for j in range(num_frames)])
+                for i in range(batch_size)
+            ]
+        finally:
+            torch.set_float32_matmul_precision(previous_precision)
+        num_tracks = max((len(star) for star in stars), default=0)
+        track = torch.zeros(batch_size, num_frames, num_tracks, 2)
+        vis = torch.zeros(batch_size, num_frames, num_tracks)
+        for i, star in enumerate(stars):
+            for k, observations in enumerate(star):
+                for j, (point, score) in observations.items():
+                    track[i, j, k] = torch.from_numpy(point)
+                    vis[i, j, k] = score
+            for j in range(num_frames):
+                standardize_query_points(track[i, j], batch["images_change"][i][j])
+        track = track.to(self.device)
+        vis = vis.to(self.device)
+        return {"track": track, "vis": vis, "conf": vis.clone()}
diff --git a/gluemap/ff_inference/amb3r_inference.py b/gluemap/ff_inference/amb3r_inference.py
new file mode 100644
index 0000000..6133493
--- /dev/null
+++ b/gluemap/ff_inference/amb3r_inference.py
@@ -0,0 +1,160 @@
+import json
+import os
+import struct
+import subprocess
+import tempfile
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from gluemap.ff_inference.local_inference import LocalInference, confident_depth_mask
+
+_STDERR_TAIL_BYTES = 4000
+
+
+class Amb3rWorkerClient:
+    """Drive ``amb3r_worker.py`` in the AMB3R environment over a binary pipe.
+
+    AMB3R needs spconv/pytorch3d/flash-attn on a different Python than GlueMap,
+    so it lives in a separate process. Depth and translations come back in
+    metres (see ``amb3r_worker.py``).
+    """
+
+    def __init__(self, python: str, source: str, checkpoint: str) -> None:
+        self.process = None
+        if not python or not source or not checkpoint:
+            raise ValueError("amb3r requires --amb3r_python, --amb3r_source and --path_feedforward")
+        for label, value in (("python", python), ("source", source), ("checkpoint", checkpoint)):
+            if not Path(value).expanduser().exists():
+                raise ValueError(f"amb3r {label} does not exist: {value}")
+        worker = Path(__file__).with_name("amb3r_worker.py").resolve()
+        self._stderr = tempfile.TemporaryFile()
+        self.process = subprocess.Popen(
+            [
+                str(Path(python).expanduser()),
+                str(worker),
+                "--source",
+                str(Path(source).expanduser().resolve()),
+                "--checkpoint",
+                str(Path(checkpoint).expanduser().resolve()),
+            ],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=self._stderr,
+        )
+        header, _ = self._receive_header()
+        if not header.get("ready"):
+            self._fail("AMB3R worker did not signal readiness")
+
+    def _stderr_tail(self) -> str:
+        self._stderr.flush()
+        self._stderr.seek(0, os.SEEK_END)
+        size = self._stderr.tell()
+        self._stderr.seek(max(0, size - _STDERR_TAIL_BYTES))
+        return self._stderr.read().decode("utf-8", errors="replace")
+
+    def _fail(self, message: str) -> None:
+        raise RuntimeError(f"{message}\n--- worker stderr (tail) ---\n{self._stderr_tail()}")
+
+    def _read_exact(self, size: int) -> bytes:
+        chunks = []
+        remaining = size
+        while remaining:
+            chunk = self.process.stdout.read(remaining)
+            if not chunk:
+                self._fail("AMB3R worker closed its output unexpectedly")
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        return b"".join(chunks)
+
+    def _receive_header(self):
+        (length,) = struct.unpack("<Q", self._read_exact(8))
+        header = json.loads(self._read_exact(length).decode("utf-8"))
+        if "error" in header:
+            self._fail(f"AMB3R worker error: {header['error']}")
+        return header, length
+
+    def predict_arrays(self, images: np.ndarray) -> dict:
+        """Run AMB3R on float32 ``(B, N, 3, H, W)`` images in [0, 1]."""
+        images = np.ascontiguousarray(images, dtype="<f4")
+        header = json.dumps({"shape": list(images.shape)}).encode("utf-8")
+        try:
+            self.process.stdin.write(struct.pack("<Q", len(header)))
+            self.process.stdin.write(header)
+            self.process.stdin.write(images.tobytes())
+            self.process.stdin.flush()
+        except (BrokenPipeError, OSError):
+            self._fail("AMB3R worker pipe is broken")
+        response, _ = self._receive_header()
+        arrays = {}
+        for name, shape in response["arrays"].items():
+            count = int(np.prod(shape))
+            data = self._read_exact(count * 4)
+            arrays[name] = np.frombuffer(data, dtype="<f4").reshape(shape).copy()
+        return arrays
+
+    def close(self) -> None:
+        process = getattr(self, "process", None)
+        if process is None:
+            return
+        self.process = None
+        try:
+            if process.stdin:
+                process.stdin.close()
+            try:
+                process.wait(timeout=30)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+        finally:
+            if process.stdout:
+                process.stdout.close()
+            self._stderr.close()
+
+    def __del__(self) -> None:
+        try:
+            self.close()
+        except Exception:
+            pass
+
+
+class Amb3rLocalInference(LocalInference):
+    """Adapt metric AMB3R outputs to GlueMap's reference-view gauge."""
+
+    def __init__(self, model, device="cuda", dtype=torch.bfloat16, confidence_quantile=0.5):
+        super().__init__(model, device, dtype)
+        if not 0 <= confidence_quantile < 1:
+            raise ValueError("confidence_quantile must be in [0, 1)")
+        self.confidence_quantile = confidence_quantile
+
+    @torch.inference_mode()
+    def predict(self, batch: dict) -> dict:
+        # Dataset stars already place the center at slot zero. Do not reorder it.
+        images = batch["images"]
+        if images.ndim != 5 or images.shape[2] != 3:
+            raise ValueError("images must have shape (B, N, 3, H, W)")
+        if any(size % 14 for size in images.shape[-2:]):
+            raise ValueError("AMB3R image dimensions must align to 14-pixel patches")
+        out = self.model.predict_arrays(images.float().cpu().numpy())
+        device = torch.device(self.device)
+        depth = torch.from_numpy(out["depth"]).to(device).unsqueeze(-1)
+        confidence = torch.from_numpy(out["depth_conf"]).to(device)
+        extrinsics = torch.from_numpy(out["extrinsic"]).to(device)
+        intrinsics = torch.from_numpy(out["intrinsic"]).to(device)
+        expected = (*images.shape[:2], *images.shape[-2:])
+        if depth.shape != (*expected, 1) or confidence.shape != expected:
+            raise ValueError("AMB3R depth/confidence shape does not match input images")
+        bottom = extrinsics.new_zeros((*extrinsics.shape[:2], 1, 4))
+        bottom[..., 0, 3] = 1
+        extrinsics = torch.cat((extrinsics, bottom), dim=-2)
+        # Rigid re-gauging keeps translation lengths (metres) unchanged.
+        extrinsics = extrinsics @ torch.linalg.inv(extrinsics[:, :1])
+        valid = confident_depth_mask(depth, confidence, self.confidence_quantile)
+        return {
+            "depth": depth,
+            "depth_conf": confidence,
+            "depth_valid_mask": valid,
+            "extrinsics": extrinsics,
+            "intrinsics": intrinsics,
+        }
diff --git a/gluemap/ff_inference/amb3r_worker.py b/gluemap/ff_inference/amb3r_worker.py
new file mode 100644
index 0000000..162f8e8
--- /dev/null
+++ b/gluemap/ff_inference/amb3r_worker.py
@@ -0,0 +1,123 @@
+"""Standalone AMB3R inference worker (runs in the AMB3R conda environment).
+
+This script must not import ``gluemap``: the AMB3R environment has a different
+Python / torch stack than GlueMap. It speaks a length-prefixed binary protocol
+over stdin/stdout (little endian):
+
+    message = uint64 header_length | UTF-8 JSON header | raw float32 C-order bytes
+
+Startup sends ``{"ready": true}``. A request header is ``{"shape": [B,N,3,H,W]}``
+followed by float32 images in [0, 1]. The response header is
+``{"arrays": {name: shape}}`` followed by the arrays concatenated in header
+order, or ``{"error": "..."}`` followed by exit code 1. EOF on stdin exits 0.
+
+Translations and depth are both multiplied by the same per-sample metric scale
+``m = median_n(median_metric_z / median(depth))`` so they stay in one unit
+(metres).
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import struct
+import sys
+import traceback
+
+
+def _read_exact(stream, size: int) -> bytes:
+    chunks = []
+    remaining = size
+    while remaining:
+        chunk = stream.read(remaining)
+        if not chunk:
+            if remaining == size and not chunks:
+                return b""
+            raise EOFError("truncated message")
+        chunks.append(chunk)
+        remaining -= len(chunk)
+    return b"".join(chunks)
+
+
+def _send(out, header: dict, payload: bytes = b"") -> None:
+    blob = json.dumps(header).encode("utf-8")
+    out.write(struct.pack("<Q", len(blob)))
+    out.write(blob)
+    out.write(payload)
+    out.flush()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True)
+    parser.add_argument("--checkpoint", required=True)
+    args = parser.parse_args()
+
+    if not os.path.isdir(args.source):
+        print(f"AMB3R source directory not found: {args.source}", file=sys.stderr)
+        sys.exit(1)
+    if not os.path.isfile(args.checkpoint):
+        print(f"AMB3R checkpoint not found: {args.checkpoint}", file=sys.stderr)
+        sys.exit(1)
+
+    # Keep the protocol channel clean: everything printed by libraries goes to stderr.
+    out = os.fdopen(os.dup(1), "wb")
+    os.dup2(2, 1)
+    stdin = sys.stdin.buffer
+
+    import numpy as np
+    import torch
+
+    sys.path.insert(0, args.source)
+    from amb3r.model import AMB3R
+
+    model = AMB3R()
+    model.load_weights(args.checkpoint)
+    model.cuda().eval()
+    _send(out, {"ready": True})
+
+    while True:
+        raw = _read_exact(stdin, 8)
+        if not raw:
+            sys.exit(0)
+        try:
+            (length,) = struct.unpack("<Q", raw)
+            header = json.loads(_read_exact(stdin, length).decode("utf-8"))
+            shape = tuple(int(v) for v in header["shape"])
+            count = int(np.prod(shape))
+            data = _read_exact(stdin, count * 4)
+            images = np.frombuffer(data, dtype="<f4").reshape(shape)
+            with torch.inference_mode():
+                x = torch.from_numpy(images.copy()).cuda() * 2.0 - 1.0
+                with torch.autocast("cuda", dtype=torch.bfloat16):
+                    res = model({"images": x})[-1]
+                depth = res["depth"].float()
+                median_depth = depth.flatten(2).median(dim=2).values
+                ratio = res["median_metric_z"].float()[..., 0] / (median_depth + 1e-8)
+                m = torch.median(ratio, dim=1).values
+                depth_metric = res["depth_metric"].float()[..., 0]
+                confidence = res["depth_conf"].float()
+                if confidence.ndim == 5:
+                    confidence = confidence.squeeze(-1)
+                extrinsic = res["extrinsic"].float().clone()
+                extrinsic[..., 3] *= m[:, None, None]
+                arrays = {
+                    "depth": depth_metric,
+                    "depth_conf": confidence,
+                    "extrinsic": extrinsic,
+                    "intrinsic": res["intrinsic"].float(),
+                }
+                arrays = {k: v.cpu().numpy().astype("<f4", copy=False) for k, v in arrays.items()}
+            _send(
+                out,
+                {"arrays": {k: list(v.shape) for k, v in arrays.items()}},
+                b"".join(np.ascontiguousarray(v).tobytes() for v in arrays.values()),
+            )
+        except Exception:
+            tail = "".join(traceback.format_exc().splitlines(keepends=True)[-12:])
+            _send(out, {"error": tail})
+            sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
