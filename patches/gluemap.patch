+import logging
+from types import SimpleNamespace
+
+import numpy as np
+
+from gluemap.utils import colmap
+
+
+class _FakeCamera:
+    def __init__(self, focal_length):
+        self.focal_length = focal_length
+
+    def calibration_matrix(self):
+        return np.asarray(
+            [
+                [self.focal_length, 0.0, 320.0],
+                [0.0, self.focal_length, 240.0],
+                [0.0, 0.0, 1.0],
+            ]
+        )
+
+
+class _FakeReconstruction:
+    def __init__(self):
+        self.cameras = {
+            10: _FakeCamera(500.0),
+            20: _FakeCamera(600.0),
+            30: _FakeCamera(700.0),
+        }
+        self.images = {
+            1: SimpleNamespace(name="S00/000000.jpg", camera_id=10),
+            2: SimpleNamespace(name="S01/000001.jpg", camera_id=20),
+            3: SimpleNamespace(name="S02/000002.jpg", camera_id=30),
+        }
+
+    def read(self, _gt_path):
+        return None
+
+
+def test_gt_intrinsics_allocates_by_camera_ids_not_image_indices(
+    monkeypatch, caplog
+):
+    image_count = 1414
+    images_list = [f"S{i % 3:02d}/{i:06d}.jpg" for i in range(image_count)]
+    intrinsics_mapping = {i: i % 3 for i in range(image_count)}
+    monkeypatch.setattr(colmap.pycolmap, "Reconstruction", _FakeReconstruction)
+
+    with caplog.at_level(logging.INFO, logger=colmap.__name__):
+        result = colmap.extract_gt_intrinsics(
+            "/unused/fake-model", images_list, intrinsics_mapping
+        )
+
+    assert len(result) == 3
+    assert all(intrinsics is not None for intrinsics in result)
+    assert "GT intrinsics loaded: 3/3 cameras matched" in caplog.text
