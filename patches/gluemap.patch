+++ b/tests/test_amb3r_inference.py
@@ -0,0 +1,93 @@
+import sys
+
+import numpy as np
+import pytest
+import torch
+
+from gluemap.estimators.covisibility_extraction import CovisibilityExtraction
+from gluemap.ff_inference.amb3r_inference import Amb3rLocalInference, Amb3rWorkerClient
+
+
+def _rotation(seed: int) -> np.ndarray:
+    q, _ = np.linalg.qr(np.random.default_rng(seed).normal(size=(3, 3)))
+    return q * np.sign(np.linalg.det(q))
+
+
+class _StubClient:
+    def __init__(self, extrinsic: np.ndarray, height: int, width: int):
+        self.extrinsic = extrinsic
+        self.height = height
+        self.width = width
+
+    def predict_arrays(self, images):
+        batch, views = images.shape[:2]
+        intrinsic = np.tile(
+            np.array([[30.0, 0, self.width / 2], [0, 30.0, self.height / 2], [0, 0, 1]], np.float32),
+            (batch, views, 1, 1),
+        )
+        return {
+            "depth": np.full((batch, views, self.height, self.width), 5.0, np.float32),
+            "depth_conf": np.ones((batch, views, self.height, self.width), np.float32),
+            "extrinsic": self.extrinsic.astype(np.float32),
+            "intrinsic": intrinsic,
+        }
+
+
+def test_extrinsics_normalised_to_first_view_and_stay_metric():
+    rotations = [_rotation(seed) for seed in range(3)]
+    centers = [np.array([4.0, -2.0, 1.0]), np.array([7.0, -2.0, 1.5]), np.array([4.0, 3.0, 2.0])]
+    extrinsic = np.zeros((1, 3, 3, 4))
+    for view, (rotation, center) in enumerate(zip(rotations, centers)):
+        extrinsic[0, view, :, :3] = rotation
+        extrinsic[0, view, :, 3] = -rotation @ center
+    inference = Amb3rLocalInference(_StubClient(extrinsic, 28, 42), device="cpu", confidence_quantile=0.25)
+    out = inference.predict({"images": torch.zeros(1, 3, 3, 28, 42)})
+
+    torch.testing.assert_close(out["extrinsics"][:, 0], torch.eye(4)[None], atol=1e-5, rtol=0)
+    # Relative translation length is the baseline in the reference camera frame:
+    # ||t_j - R_j R_0^T t_0||, computed here directly from the input poses.
+    for view in (1, 2):
+        relative_t = extrinsic[0, view, :, 3] - extrinsic[0, view, :, :3] @ rotations[0].T @ extrinsic[0, 0, :, 3]
+        assert out["extrinsics"][0, view, :3, 3].norm().item() == pytest.approx(
+            np.linalg.norm(relative_t), rel=1e-4
+        )
+    assert out["depth"].shape == (1, 3, 28, 42, 1)
+    assert out["depth_valid_mask"].any()
+
+
+def test_covisibility_is_unit_equivariant():
+    height = width = 32
+
+    def run(scale: float):
+        extrinsics = torch.eye(4)[None, None].expand(1, 2, -1, -1).clone()
+        extrinsics[0, 1, :3, 3] = torch.tensor([0.3, 0.1, 0.0]) * scale
+        intrinsics = torch.tensor(
+            [[20.0, 0.0, width / 2], [0.0, 20.0, height / 2], [0.0, 0.0, 1.0]]
+        )[None, None].expand(1, 2, -1, -1).clone()
+        depth = torch.full((1, 2, height, width, 1), 2.0 * scale)
+        valid = torch.ones((1, 2, height, width), dtype=torch.bool)
+        extractor = CovisibilityExtraction(virtual_stride=8)
+        world = extractor._convert_from_depth_to_world_points(depth, extrinsics, intrinsics)
+        scores, _ = extractor._verify_by_reprojection_n2(
+            world, extrinsics, intrinsics, depth_valid_mask=valid
+        )
+        torch.manual_seed(0)  # virtual depths carry 10% multiplicative noise
+        tracks = extractor._calculate_virtual_tracks(depth, extrinsics, intrinsics, valid)[0]
+        return scores, tracks
+
+    scores_1, tracks_1 = run(1.0)
+    scores_8, tracks_8 = run(8.0)
+    assert scores_1[0, 1] > 0
+    torch.testing.assert_close(scores_8, scores_1, atol=1e-4, rtol=1e-4)
+    torch.testing.assert_close(tracks_8, tracks_1, atol=1e-3, rtol=1e-4, equal_nan=True)
+
+
+def test_worker_failure_reports_stderr(tmp_path):
+    with pytest.raises(ValueError):
+        Amb3rWorkerClient(sys.executable, str(tmp_path / "missing"), str(tmp_path / "missing.pt"))
+    source = tmp_path / "source"
+    source.mkdir()
+    checkpoint = tmp_path / "empty.pt"
+    checkpoint.write_bytes(b"")
+    with pytest.raises(RuntimeError, match="amb3r"):
+        Amb3rWorkerClient(sys.executable, str(source), str(checkpoint))
