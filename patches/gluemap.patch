@@ -0,0 +1,68 @@
+import argparse
+
+import numpy as np
+import torch
+from PIL import Image
+
+from gluemap.datasets import multi_sequence_twoview as multi
+
+
+def test_all_forced_pairs_resolve_through_the_real_constructor(
+    tmp_path, monkeypatch
+):
+    images_root = (tmp_path / "images").resolve()
+    for sequence, count in (("S01", 100), ("S02", 60)):
+        sequence_dir = images_root / sequence
+        sequence_dir.mkdir(parents=True)
+        for index in range(count):
+            Image.new("RGB", (32, 18), color=(index % 255, 1, 2)).save(
+                sequence_dir / f"{index:06d}.jpg"
+            )
+
+    forced_pairs_path = tmp_path / "forced_bridges.txt"
+    forced_lines = []
+    for i in range(100):
+        for j in range(60):
+            prefix = "./" if (i + j) % 2 else ""
+            forced_lines.append(
+                f"{prefix}S01/{i:06d}.jpg {prefix}S02/{j:06d}.jpg"
+            )
+    forced_pairs_path.write_text(
+        "\n".join(forced_lines) + "\n", encoding="utf-8"
+    )
+
+    def fake_descriptors(self, _args, _dataset, image_names):
+        count = len(image_names)
+        neighbors = np.arange(count, dtype=np.int64).reshape(count, 1)
+        descriptors = torch.zeros((count, 1), dtype=torch.float32)
+        return neighbors, descriptors
+
+    monkeypatch.setattr(
+        multi.MultiSequencePairs,
+        "_retrieve_descriptors_and_neighbors",
+        fake_descriptors,
+    )
+    monkeypatch.setattr(
+        multi,
+        "retrieve_global_neighbors",
+        lambda *_args, **_kwargs: np.empty((0, 2), dtype=np.int64),
+    )
+
+    args = argparse.Namespace(
+        images_path=str(images_root),
+        camera_model="PINHOLE",
+        curr_processed=str(tmp_path / "processed"),
+        num_neighbors_sequential=0,
+        intrinsics_mode="SHARED",
+        extra_pairs_path=str(forced_pairs_path),
+    )
+    dataset = multi.MultiSequencePairs(args, ["S01", "S02"])
+
+    expected_pairs = {(i, 100 + j) for i in range(100) for j in range(60)}
+    actual_pairs = {tuple(pair) for pair in dataset.pairs.tolist()}
+
+    assert dataset.images_path_root == str(images_root)
+    assert dataset.images_list[:2] == ["S01/000000.jpg", "S01/000001.jpg"]
+    assert len(expected_pairs) == 6000
+    assert actual_pairs == expected_pairs
+    assert all(i < j for i, j in actual_pairs)
diff --git a/tests/test_omega_covisibility.py b/tests/test_omega_covisibility.py
new file mode 100644
index 0000000..726cab9
--- /dev/null
+++ b/tests/test_omega_covisibility.py
@@ -0,0 +1,53 @@
+import torch
+
+from gluemap.estimators.covisibility_extraction import CovisibilityExtraction
+
+
+def _scene(height=32, width=32):
+    extrinsics = torch.eye(4)[None, None].expand(1, 2, -1, -1).clone()
+    intrinsics = torch.tensor(
+        [[20.0, 0.0, width / 2], [0.0, 20.0, height / 2], [0.0, 0.0, 1.0]]
+    )[None, None].expand(1, 2, -1, -1).clone()
+    depth = torch.linspace(1.0, 3.0, height * width).reshape(1, 1, height, width, 1)
+    return depth.expand(1, 2, -1, -1, -1), extrinsics, intrinsics
+
+
+def test_disjoint_confidence_masks_do_not_support_an_edge():
+    depth, extrinsics, intrinsics = _scene()
+    extractor = CovisibilityExtraction(virtual_stride=16)
+    world = extractor._convert_from_depth_to_world_points(depth, extrinsics, intrinsics)
+    mask = torch.zeros((1, 2, 32, 32), dtype=torch.bool)
+    mask[:, 0, :, :16] = True
+    mask[:, 1, :, 16:] = True
+    scores, valid = extractor._verify_by_reprojection_n2(
+        world, extrinsics, intrinsics, depth_valid_mask=mask
+    )
+    assert scores[0, 1] == 0
+    assert not valid[:, 1].any()
+
+
+def test_no_confident_depth_yields_no_neighbor_support():
+    depth, extrinsics, intrinsics = _scene()
+    extractor = CovisibilityExtraction(virtual_stride=16)
+    world = extractor._convert_from_depth_to_world_points(depth, extrinsics, intrinsics)
+    scores, valid = extractor._verify_by_reprojection_n2(
+        world, extrinsics, intrinsics,
+        depth_valid_mask=torch.zeros((1, 2, 32, 32), dtype=torch.bool),
+    )
+    assert torch.isfinite(scores).all()
+    assert scores[0, 1] == 0
+    assert not valid.any()
+
+
+def test_omega_virtual_grid_uses_sixteen_pixel_stride():
+    depth, extrinsics, intrinsics = _scene(288, 512)
+    extractor = CovisibilityExtraction(virtual_stride=16)
+    valid = torch.ones((1, 2, 288, 512), dtype=torch.bool)
+    tracks, _, _, _ = extractor._calculate_virtual_tracks(
+        depth, extrinsics, intrinsics, valid
+    )
+    grid_x, grid_y = torch.meshgrid(
+        torch.arange(8, 512, 16), torch.arange(8, 288, 16), indexing="xy"
+    )
+    expected = torch.stack((grid_x, grid_y), dim=-1).reshape(576, 2).float()
+    torch.testing.assert_close(tracks[0, 0], expected, atol=1e-4, rtol=1e-5)
