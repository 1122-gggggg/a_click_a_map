new file mode 100644
index 0000000..817918c
--- /dev/null
+++ b/tests/test_inference_checkpoint.py
@@ -0,0 +1,110 @@
+"""A killed inference stage must resume from its last partial checkpoint."""
+
+import argparse
+import os
+
+import pytest
+import torch
+
+from gluemap.controllers.base_inference import BaseInferencePipeline
+
+
+class _Dataset:
+    def __len__(self):
+        return 10
+
+    def __getitem__(self, idx):
+        return {"x": torch.tensor([float(idx)]), "idx": idx}
+
+
+class _Pipeline(BaseInferencePipeline):
+    _index_key = "idx"
+    _rerun_from_triggers = None
+    _profiling_label = "Fake"
+
+    def __init__(self, args, fail_at=None):
+        super().__init__(args, 1, 0, "fake_result.pth")
+        self.fail_at = fail_at
+        self.processed = []
+
+    def _load_models(self):
+        return {}
+
+    def _create_batch_inference(self, models):
+        return None
+
+    def _run_batch_step(self, batch_inference, batch):
+        idx = int(batch["idx"])
+        if idx == self.fail_at:
+            raise RuntimeError("killed")
+        self.processed.append(idx)
+        return {"value": batch["x"] * 2}, {"times": 0.5}
+
+    def _pack_local_outputs(self, all_outputs, all_indices):
+        return {"value": [o["value"] for o in all_outputs]}
+
+    def _merge_gathered_outputs(self, data_list, index_mapping, dataset_size):
+        raise AssertionError("not distributed")
+
+    def _postprocess_global_outputs(self, global_outputs, dataset):
+        return global_outputs
+
+    def _batch_size(self):
+        return 1
+
+
+def _args(tmp_path, **overrides):
+    values = dict(
+        distributed=False, num_workers=0, force_load=True,
+        curr_path=str(tmp_path), checkpoint_every=2, rerun_from=None,
+    )
+    values.update(overrides)
+    return argparse.Namespace(**values)
+
+
+@pytest.fixture(autouse=True)
+def _no_cuda_sync(monkeypatch):
+    monkeypatch.setattr(torch.cuda, "synchronize", lambda *a, **k: None)
+
+
+def test_killed_stage_resumes_without_recomputing_checkpointed_items(tmp_path):
+    expected, _ = _Pipeline(_args(tmp_path / "reference")).run(_Dataset())
+
+    interrupted = _Pipeline(_args(tmp_path / "run"), fail_at=5)
+    with pytest.raises(RuntimeError, match="killed"):
+        interrupted.run(_Dataset())
+    assert interrupted.processed == [0, 1, 2, 3, 4]
+    assert os.path.exists(tmp_path / "run" / "fake_result.pth.partial")
+    assert not os.path.exists(tmp_path / "run" / "fake_result.pth")
+
+    resumed = _Pipeline(_args(tmp_path / "run"))
+    result, timing = resumed.run(_Dataset())
+    assert resumed.processed == [4, 5, 6, 7, 8, 9]
+    assert result["idx"] == list(range(10))
+    torch.testing.assert_close(
+        torch.cat(result["value"]), torch.cat(expected["value"])
+    )
+    assert timing["num_batches"] == 10
+    assert not os.path.exists(tmp_path / "run" / "fake_result.pth.partial")
+
+
+def test_partial_from_different_dataset_is_discarded(tmp_path):
+    with pytest.raises(RuntimeError):
+        _Pipeline(_args(tmp_path), fail_at=5).run(_Dataset())
+
+    class _Shorter(_Dataset):
+        def __len__(self):
+            return 8
+
+    fresh = _Pipeline(_args(tmp_path))
+    result, _ = fresh.run(_Shorter())
+    assert fresh.processed == list(range(8))
+    assert result["idx"] == list(range(8))
+
+
+def test_checkpointing_off_by_default_leaves_no_partial(tmp_path):
+    with pytest.raises(RuntimeError):
+        _Pipeline(
+            _args(tmp_path, checkpoint_every=0), fail_at=5
+        ).run(_Dataset())
+    assert not os.path.exists(tmp_path / "fake_result.pth.partial")
