+++ b/tests/test_reprojection_error.py
@@ -0,0 +1,28 @@
+"""Normalized reprojection errors must respect both PINHOLE focal lengths."""
+
+import numpy as np
+import pycolmap
+
+from gluemap.math.reprojection_error import (
+    ReprojectionErrorType,
+    _compute_errors_batch,
+    compute_point_error,
+)
+
+
+def test_pinhole_normalized_error_uses_per_axis_focals():
+    camera = pycolmap.Camera(
+        model='PINHOLE', width=1920, height=1080,
+        params=[1000, 500, 960, 540],
+    )
+    point = np.array([0.0, 0.0, 5.0])
+    observed = np.array([970.0, 545.0])
+    single = compute_point_error(
+        point, np.eye(3), np.zeros(3), observed,
+        camera, ReprojectionErrorType.NORMALIZED,
+    )
+    batch = _compute_errors_batch(
+        point[None], observed[None], camera,
+        np.array([False]), ReprojectionErrorType.NORMALIZED,
+    )
+    np.testing.assert_allclose([single, batch[0]], np.sqrt(2) * 0.01, rtol=1e-12)
