+++ b/tests/test_moge3_depth.py
@@ -0,0 +1,125 @@
+"""CPU regressions for content coordinates and scale-aligned depth replacement."""
+
+import math
+
+import numpy as np
+import pytest
+import torch
+
+from gluemap.ff_inference.local_inference import LocalInference
+from gluemap.ff_inference.moge3_depth import (
+    MoGe3DepthLocalInference,
+    align_moge_depth,
+    content_box,
+)
+from gluemap.utils.load_fn import calculate_image_shapes
+
+
+def test_content_box_wulai_resolutions():
+    shapes = [(1080, 1920), (1512, 2688), (2160, 3840)]
+    changes = calculate_image_shapes(shapes, (518, 518))
+    for shape, change in zip(shapes, changes):
+        assert content_box(change, shape, (518, 518)) == (0, 112, 518, 294)
+    change = calculate_image_shapes(shapes[:1], (294, 518))[0]
+    assert content_box(change, shapes[0], (294, 518)) == (0, 0, 518, 294)
+
+
+@pytest.mark.parametrize('change', [(0, 1, 0, 0), (1, 1, -1, 0), (1, 1, 1, 0)])
+def test_content_box_rejects_empty_or_outside_canvas(change):
+    with pytest.raises(ValueError):
+        content_box(change, (20, 30), (20, 30))
+
+
+def test_alignment_rejects_low_confidence_corruption_and_confident_outliers():
+    generator = torch.Generator().manual_seed(7)
+    moge = torch.rand((40, 50), generator=generator) + 0.5
+    backbone = 3.7 * moge
+    confidence = torch.zeros_like(moge)
+    confidence[:20] = 10
+    backbone[20:] *= 5
+    outliers = torch.randperm(1000, generator=generator)[:100]
+    backbone[:20].reshape(-1)[outliers] *= (
+        torch.rand((100,), generator=generator) * 20 + 2
+    )
+    scale = align_moge_depth(backbone, confidence, moge, torch.ones_like(moge, dtype=torch.bool))
+    assert scale == pytest.approx(3.7, abs=1e-5)
+    valid = torch.zeros_like(moge, dtype=torch.bool)
+    valid.reshape(-1)[:99] = True
+    assert align_moge_depth(backbone, confidence, moge, valid) is None
+    # Enough eligible pixels but fewer than 100 survive the confidence cutoff.
+    valid.reshape(-1)[:150] = True
+    confidence = torch.arange(2000).reshape(40, 50).float()
+    assert align_moge_depth(backbone, confidence, moge, valid) is None
+
+
+class StubBackbone(LocalInference):
+    def __init__(self):
+        super().__init__(torch.nn.Identity(), 'cpu', torch.float32)
+        self.depth = torch.full((1, 2, 518, 518, 1), 99.0)
+        self.depth[:, :, 112:406] = 6.0
+        self.conf = torch.ones((1, 2, 518, 518))
+        self.intrinsics = torch.eye(3).repeat(1, 2, 1, 1)
+        self.intrinsics[..., 0, 0] = 400
+        self.extrinsics = torch.eye(4).repeat(1, 2, 1, 1)
+
+    def predict(self, batch):
+        return {
+            'depth': self.depth.clone(),
+            'depth_conf': self.conf,
+            'intrinsics': self.intrinsics,
+            'extrinsics': self.extrinsics,
+        }
+
+
+class StubClient:
+    def __init__(self, all_invalid):
+        self.all_invalid = all_invalid
+        self.requests = []
+
+    def infer_depth(self, keys, images, fov_x):
+        self.requests.append((keys, images.copy(), fov_x.copy()))
+        n, _, h, w = images.shape
+        depth = np.full((n, h, w), 2.0, dtype=np.float32)
+        depth[:, :, int(0.7 * w):] = 2.5
+        valid = np.ones((n, h, w), dtype=bool)
+        valid[:, :10] = False
+        if self.all_invalid:
+            valid[:] = False
+        return depth, valid
+
+
+@pytest.mark.parametrize('all_invalid', [False, True])
+def test_replacement_preserves_padding_invalid_pixels_and_backbone_metadata(all_invalid):
+    images = torch.rand((1, 2, 3, 518, 518), generator=torch.Generator().manual_seed(11))
+    shapes = [(1080, 1920)] * 2
+    batch = {
+        'images': images,
+        'images_change': torch.tensor(calculate_image_shapes(shapes, (518, 518))),
+        'images_shape_ori': torch.tensor(shapes),
+        'image_paths': [('first.jpg',), ('second.jpg',)],
+    }
+    batch['images_change'] = batch['images_change'][None]
+    batch['images_shape_ori'] = batch['images_shape_ori'][None]
+    backbone = StubBackbone()
+    client = StubClient(all_invalid)
+    pred = MoGe3DepthLocalInference(backbone, client).predict(batch)
+    keys, crops, fovs = client.requests[0]
+    assert keys == ['first.jpg', 'second.jpg']
+    np.testing.assert_array_equal(crops, images[0, :, :, 112:406].numpy())
+    np.testing.assert_allclose(fovs, math.degrees(2 * math.atan(518 / 800)))
+    expected = backbone.depth.clone()
+    if not all_invalid:
+        expected[:, :, 122:406, int(0.7 * 518):] = 7.5
+    torch.testing.assert_close(pred['depth'], expected, rtol=0, atol=1e-6)
+    assert pred['depth_conf'] is backbone.conf
+    assert pred['intrinsics'] is backbone.intrinsics
+    assert pred['extrinsics'] is backbone.extrinsics
+
+
+def test_replacement_rejects_non_canvas_backbone_depth():
+    backbone = StubBackbone()
+    backbone.depth = backbone.depth[:, :, ::2, ::2]
+    with pytest.raises(ValueError, match='input canvas resolution'):
+        MoGe3DepthLocalInference(backbone, StubClient(False)).predict(
+            {'images': torch.zeros((1, 2, 3, 518, 518))}
+        )
