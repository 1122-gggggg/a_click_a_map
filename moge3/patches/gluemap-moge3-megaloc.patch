@@ -0,0 +1,209 @@
+"""Standalone MoGe-3 depth worker (runs in the MoGe-3 conda environment).
+
+This script must not import ``gluemap``: the MoGe-3 environment has a different
+Python / torch stack than GlueMap. It speaks a length-prefixed binary protocol
+over stdin/stdout (little endian):
+
+    message = uint64 header_length | UTF-8 JSON header | raw float32 C-order bytes
+
+Startup sends ``{"ready": true, "moge_file": ..., "num_tokens": ...}``. A request
+header is ``{"keys": [str]*n, "fov_x": [float]*n, "shape": [n,3,h,w]}`` followed
+by float32 images in [0, 1]. The response header is
+``{"arrays": {"depth": [n,h,w], "mask": [n,h,w]}, "forwarded": m}`` followed by
+the depth array and the mask array (1.0 / 0.0) concatenated in header order, or
+``{"error": "..."}`` followed by exit code 1. EOF on stdin exits 0.
+
+Each image is forwarded through the ViT-L backbone plus sparse 3D refiner at
+most once per (key, shape); the resulting point map is cached on CPU in fp16
+and the per-request horizontal FOV only re-solves the affine depth shift, which
+is exactly ``MoGeModel.infer(fov_x=...)`` up to the per-image metric scale.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import struct
+import sys
+import traceback
+from collections import OrderedDict
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+
+FORWARD_CHUNK = 2
+MAX_CACHED_IMAGES = 4096
+
+
+def _read_exact(stream, size: int) -> bytes:
+    chunks = []
+    remaining = size
+    while remaining:
+        chunk = stream.read(remaining)
+        if not chunk:
+            if remaining == size and not chunks:
+                return b""
+            raise EOFError("truncated message")
+        chunks.append(chunk)
+        remaining -= len(chunk)
+    return b"".join(chunks)
+
+
+def _send(out, header: dict, payload: bytes = b"") -> None:
+    blob = json.dumps(header).encode("utf-8")
+    out.write(struct.pack("<Q", len(blob)))
+    out.write(blob)
+    out.write(payload)
+    out.flush()
+
+
+def compute_points(
+    model: Any, images: torch.Tensor, num_tokens: int, refine_steps: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Run the MoGe-3 forward pass on fp32 CUDA ``(n,3,h,w)`` images.
+
+    Returns ``(points, mask)`` with ``points`` fp32 ``(n,h,w,3)`` and ``mask``
+    bool ``(n,h,w)``, matching ``MoGeModel.infer`` with ``use_fp16=False``.
+    """
+    with torch.inference_mode():
+        out = model.forward(images, num_tokens=num_tokens, refine_steps=refine_steps)
+    return out["points"].float(), out["mask"] > 0.5
+
+
+def depth_for_fov(
+    points: torch.Tensor, mask: torch.Tensor, fov_x_deg: Any
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Convert cached affine points to depth for the given per-image FOVs.
+
+    ``points`` is fp32 CPU ``(n,h,w,3)``, ``mask`` is bool ``(n,h,w)`` and
+    ``fov_x_deg`` broadcasts to ``(n,)``. This reproduces
+    ``MoGeModel.infer(fov_x=...)`` (v3.py focal formula plus ``z + shift``)
+    without the metric scale, which the caller absorbs by depth alignment.
+    """
+    from moge.utils.geometry_torch import recover_focal_shift
+
+    fov = torch.as_tensor(fov_x_deg, dtype=torch.float32).reshape(-1)
+    h, w = points.shape[1], points.shape[2]
+    a = w / h
+    focal = a / (1 + a**2) ** 0.5 / torch.tan(torch.deg2rad(fov) / 2)
+    _, shift = recover_focal_shift(points, mask, focal=focal)
+    depth = points[..., 2] + shift[:, None, None]
+    return depth, mask & (depth > 0)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True)
+    parser.add_argument("--checkpoint", required=True)
+    parser.add_argument("--resolution-level", type=int, required=True)
+    parser.add_argument("--refine-steps", type=int, required=True)
+    args = parser.parse_args()
+
+    if not os.path.isdir(args.source):
+        print(f"MoGe source directory not found: {args.source}", file=sys.stderr)
+        sys.exit(1)
+
+    # Keep the protocol channel clean: everything printed by libraries goes to stderr.
+    out = os.fdopen(os.dup(1), "wb")
+    os.dup2(2, 1)
+    stdin = sys.stdin.buffer
+
+    sys.path.insert(0, args.source)
+    import moge
+    from moge.model.v3 import MoGeModel
+
+    moge_file = Path(moge.__file__).resolve()
+    if moge_file != Path(args.source).resolve() and Path(args.source).resolve() not in moge_file.parents:
+        print(
+            f"MoGe imported from {moge_file}, not from --source {args.source}",
+            file=sys.stderr,
+        )
+        sys.exit(1)
+
+    torch.cuda.set_device(int(os.environ.get("LOCAL_RANK", "0")))
+    model = MoGeModel.from_pretrained(args.checkpoint).cuda().eval()
+    lo, hi = model.num_tokens_range
+    num_tokens = int(lo + args.resolution_level / 9 * (hi - lo))
+    _send(out, {"ready": True, "moge_file": str(moge_file), "num_tokens": num_tokens})
+
+    cache: OrderedDict[str, tuple[torch.Tensor, torch.Tensor]] = OrderedDict()
+
+    while True:
+        raw = _read_exact(stdin, 8)
+        if not raw:
+            sys.exit(0)
+        try:
+            (length,) = struct.unpack("<Q", raw)
+            header = json.loads(_read_exact(stdin, length).decode("utf-8"))
+            keys = [str(k) for k in header["keys"]]
+            fov_x = header["fov_x"]
+            shape = tuple(int(v) for v in header["shape"])
+            if len(shape) != 4 or shape[1] != 3:
+                raise ValueError(f"expected shape [n,3,h,w], got {list(shape)}")
+            n, _, h, w = shape
+            if len(keys) != n or len(fov_x) != n:
+                raise ValueError(
+                    f"keys ({len(keys)}) / fov_x ({len(fov_x)}) disagree with n={n}"
+                )
+            count = int(np.prod(shape))
+            data = _read_exact(stdin, count * 4)
+            images = np.frombuffer(data, dtype="<f4").reshape(shape)
+
+            for key in keys:
+                entry = cache.get(key)
+                if entry is not None and entry[0].shape[:2] == (h, w):
+                    cache.move_to_end(key)
+            missing: list[str] = []
+            for key in keys:
+                entry = cache.get(key)
+                if (entry is None or entry[0].shape[:2] != (h, w)) and key not in missing:
+                    missing.append(key)
+            index_of = {}
+            for i, key in enumerate(keys):
+                index_of.setdefault(key, i)
+            with torch.inference_mode():
+                for start in range(0, len(missing), FORWARD_CHUNK):
+                    chunk_keys = missing[start : start + FORWARD_CHUNK]
+                    chunk = torch.from_numpy(
+                        images[[index_of[k] for k in chunk_keys]]
+                    ).cuda()
+                    pts, msk = compute_points(
+                        model, chunk, num_tokens, args.refine_steps
+                    )
+                    for key, p, m in zip(chunk_keys, pts, msk):
+                        cache[key] = (p.half().cpu(), m.cpu())
+                        cache.move_to_end(key)
+                    del chunk, pts, msk
+            if missing:
+                torch.cuda.empty_cache()
+
+            stacked_points = torch.stack([cache[k][0] for k in keys]).float()
+            stacked_mask = torch.stack([cache[k][1] for k in keys])
+            depth, valid = depth_for_fov(stacked_points, stacked_mask, fov_x)
+            while len(cache) > MAX_CACHED_IMAGES:
+                cache.popitem(last=False)
+            arrays = {
+                "depth": np.ascontiguousarray(depth.numpy().astype("<f4", copy=False)),
+                "mask": np.ascontiguousarray(
+                    valid.float().numpy().astype("<f4", copy=False)
+                ),
+            }
+            _send(
+                out,
+                {
+                    "arrays": {k: list(v.shape) for k, v in arrays.items()},
+                    "forwarded": len(missing),
+                },
+                b"".join(v.tobytes() for v in arrays.values()),
+            )
+        except Exception:
+            tail = "".join(traceback.format_exc().splitlines(keepends=True)[-12:])
+            _send(out, {"error": tail})
+            sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
