--- /dev/null
+++ b/gluemap/ff_inference/moge3_depth.py
@@ -0,0 +1,424 @@
+"""MoGe-3 ViT-L depth replacement for star inference.
+
+The backbone (Pi3/Pi3X, VGGT, MapAnything) still predicts poses and intrinsics;
+only its depth maps are replaced. MoGe-3 needs a newer torch stack than GlueMap,
+so it runs in a subprocess worker (:mod:`gluemap.ff_inference.moge3_worker`)
+driven over a length-prefixed binary pipe, following the ``amb3r_inference.py``
+pattern. Per image, MoGe depth is scale-aligned to the backbone depth via a
+robust log-median ratio over the backbone's most confident pixels.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import os
+import struct
+import subprocess
+import tempfile
+from collections.abc import Sequence
+from pathlib import Path
+from typing import NoReturn
+
+import numpy as np
+import torch
+
+from gluemap.ff_inference.local_inference import LocalInference
+
+logger = logging.getLogger(__name__)
+
+MOGE3_SOURCE = Path(__file__).resolve().parents[2] / "thirdparty" / "moge"
+MOGE3_RESOLUTION_LEVEL = 9
+MOGE3_REFINE_STEPS = 3
+MIN_ALIGNMENT_PIXELS = 100
+ALIGNMENT_CONF_QUANTILE = 0.5
+
+_STDERR_TAIL_BYTES = 4000
+
+
+class MoGe3WorkerClient:
+    """Drive ``moge3_worker.py`` in the MoGe-3 environment over a binary pipe.
+
+    MoGe-3 needs torch/flex_gemm unavailable in the GlueMap env, so it lives in
+    a separate process. One request sends ``(n,3,h,w)`` float32 images in
+    [0, 1] with per-image keys and horizontal FOVs; the worker forwards each
+    unique ``(key, shape)`` through the backbone at most once (caching the
+    point map) and re-solves only the affine shift per FOV.
+    """
+
+    def __init__(self, python: str, checkpoint: str) -> None:
+        self.num_requests = 0
+        self.num_images = 0
+        self.num_forwarded = 0
+        self.process: subprocess.Popen | None = None
+        self._stderr = None
+        self._ready = False
+        self._close_logged = False
+        if not python or not Path(python).expanduser().exists():
+            raise ValueError(f"MoGe-3 worker python does not exist: {python!r}")
+        if not (MOGE3_SOURCE / "moge" / "model" / "v3.py").exists():
+            raise ImportError(
+                "thirdparty/moge is not initialized; "
+                "run git submodule update --init --recursive"
+            )
+        if not checkpoint:
+            raise ValueError(
+                "MoGe-3 requires a checkpoint: local model.pt or HF repo id"
+            )
+        ckpt_path = Path(checkpoint).expanduser()
+        ckpt = str(ckpt_path.resolve()) if ckpt_path.exists() else checkpoint
+        worker = Path(__file__).with_name("moge3_worker.py").resolve()
+        try:
+            self._stderr = tempfile.TemporaryFile()
+            self.process = subprocess.Popen(
+                [
+                    str(Path(python).expanduser()),
+                    str(worker),
+                    "--source",
+                    str(MOGE3_SOURCE),
+                    "--checkpoint",
+                    ckpt,
+                    "--resolution-level",
+                    str(MOGE3_RESOLUTION_LEVEL),
+                    "--refine-steps",
+                    str(MOGE3_REFINE_STEPS),
+                ],
+                stdin=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                stderr=self._stderr,
+            )
+            header, _ = self._receive_header()
+            if not header.get("ready"):
+                self._fail("MoGe-3 worker did not signal readiness")
+            self._ready = True
+        except Exception:
+            self.close()
+            raise
+        logger.info(
+            f"MoGe-3 worker ready: {header.get('moge_file')} "
+            f"(num_tokens={header.get('num_tokens')})"
+        )
+
+    def _stderr_tail(self) -> str:
+        stderr = getattr(self, "_stderr", None)
+        if stderr is None:
+            return "<no worker stderr>"
+        stderr.flush()
+        stderr.seek(0, os.SEEK_END)
+        size = stderr.tell()
+        stderr.seek(max(0, size - _STDERR_TAIL_BYTES))
+        return stderr.read().decode("utf-8", errors="replace")
+
+    def _fail(self, message: str) -> NoReturn:
+        raise RuntimeError(
+            f"{message}\n--- worker stderr (tail) ---\n{self._stderr_tail()}"
+        )
+
+    def _read_exact(self, size: int) -> bytes:
+        chunks = []
+        remaining = size
+        while remaining:
+            chunk = self.process.stdout.read(remaining)
+            if not chunk:
+                self._fail("MoGe-3 worker closed its output unexpectedly")
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        return b"".join(chunks)
+
+    def _receive_header(self) -> tuple[dict, int]:
+        (length,) = struct.unpack("<Q", self._read_exact(8))
+        header = json.loads(self._read_exact(length).decode("utf-8"))
+        if "error" in header:
+            self._fail(f"MoGe-3 worker error: {header['error']}")
+        return header, length
+
+    def infer_depth(
+        self, keys: list[str], images: np.ndarray, fov_x: np.ndarray
+    ) -> tuple[np.ndarray, np.ndarray]:
+        """Run MoGe-3 on float32 ``(n,3,h,w)`` images in [0, 1].
+
+        Args:
+            keys: Per-image cache keys (stable across stars for the same file).
+            images: Contiguous-able ``(n,3,h,w)`` float array in [0, 1].
+            fov_x: Per-image horizontal field of view in degrees.
+
+        Returns:
+            ``(depth, valid)`` with ``depth`` float32 ``(n,h,w)`` and ``valid``
+            bool ``(n,h,w)``.
+        """
+        images = np.ascontiguousarray(images, dtype="<f4")
+        if images.ndim != 4 or images.shape[1] != 3:
+            raise ValueError(
+                "MoGe-3 infer_depth needs (n,3,h,w) images, "
+                f"got shape {images.shape}"
+            )
+        n, _, h, w = (int(v) for v in images.shape)
+        if n == 0:
+            raise ValueError("MoGe-3 infer_depth needs at least one image")
+        keys = [str(k) for k in keys]
+        fov = [float(v) for v in np.asarray(fov_x).reshape(-1).tolist()]
+        if len(keys) != n or len(fov) != n:
+            raise ValueError(
+                f"keys ({len(keys)}) / fov_x ({len(fov)}) disagree with n={n}"
+            )
+        header = json.dumps(
+            {"keys": keys, "fov_x": fov, "shape": [n, 3, h, w]}
+        ).encode("utf-8")
+        try:
+            self.process.stdin.write(struct.pack("<Q", len(header)))
+            self.process.stdin.write(header)
+            self.process.stdin.write(images.tobytes())
+            self.process.stdin.flush()
+        except (BrokenPipeError, OSError):
+            self._fail("MoGe-3 worker pipe is broken")
+        response, _ = self._receive_header()
+        arrays = {}
+        for name, shape in response["arrays"].items():
+            shape = [int(v) for v in shape]
+            count = int(np.prod(shape))
+            if count < 0:
+                self._fail(f"MoGe-3 worker sent invalid shape for {name!r}")
+            data = self._read_exact(count * 4)
+            arrays[name] = np.frombuffer(data, dtype="<f4").reshape(shape).copy()
+        if "depth" not in arrays or "mask" not in arrays:
+            self._fail("MoGe-3 worker response is missing depth/mask arrays")
+        depth = arrays["depth"]
+        mask = arrays["mask"]
+        if list(depth.shape) != [n, h, w] or list(mask.shape) != [n, h, w]:
+            self._fail(
+                f"MoGe-3 worker shape mismatch: depth {list(depth.shape)}, "
+                f"mask {list(mask.shape)}, expected [{n}, {h}, {w}]"
+            )
+        self.num_requests += 1
+        self.num_images += n
+        self.num_forwarded += int(response.get("forwarded", 0))
+        return depth.astype(np.float32, copy=False), mask > 0.5
+
+    def close(self) -> None:
+        process = getattr(self, "process", None)
+        self.process = None
+        try:
+            if process is not None:
+                try:
+                    if process.stdin:
+                        process.stdin.close()
+                except (BrokenPipeError, OSError):
+                    pass
+                try:
+                    process.wait(timeout=30)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+                if process.stdout:
+                    process.stdout.close()
+        finally:
+            stderr = getattr(self, "_stderr", None)
+            self._stderr = None
+            if stderr is not None:
+                try:
+                    stderr.close()
+                except OSError:
+                    pass
+            if (
+                process is not None
+                and getattr(self, "_ready", False)
+                and not getattr(self, "_close_logged", False)
+            ):
+                self._close_logged = True
+                logger.info(
+                    f"MoGe-3 worker: {self.num_forwarded} forward passes for "
+                    f"{self.num_images} depth maps in {self.num_requests} "
+                    "requests"
+                )
+
+    def __del__(self) -> None:
+        try:
+            self.close()
+        except Exception:
+            pass
+
+
+def content_box(
+    images_change: Sequence[float],
+    shape_ori: Sequence[int],
+    canvas_hw: tuple[int, int],
+) -> tuple[int, int, int, int]:
+    """Recover the content box of one image inside the padded canvas.
+
+    Args:
+        images_change: ``[scale_x, scale_y, x_offset, y_offset]`` mapping the
+            original image into the canvas.
+        shape_ori: Original ``[H, W]`` of the image.
+        canvas_hw: Canvas ``(H, W)``.
+
+    Returns:
+        ``(x0, y0, w, h)`` in canvas pixels.
+    """
+    sx, sy, ox, oy = (float(v) for v in images_change)
+    h_ori, w_ori = (int(v) for v in shape_ori)
+    h_canvas, w_canvas = (int(v) for v in canvas_hw)
+    x0, y0 = round(ox), round(oy)
+    w, h = round(w_ori * sx), round(h_ori * sy)
+    if w <= 0 or h <= 0:
+        raise ValueError(f"empty MoGe-3 content box: w={w}, h={h}")
+    if x0 < 0 or y0 < 0 or x0 + w > w_canvas or y0 + h > h_canvas:
+        raise ValueError(
+            f"MoGe-3 content box {(x0, y0, w, h)} extends past canvas "
+            f"(H={h_canvas}, W={w_canvas})"
+        )
+    return x0, y0, w, h
+
+
+def align_moge_depth(
+    backbone_depth: torch.Tensor,
+    backbone_conf: torch.Tensor,
+    moge_depth: torch.Tensor,
+    moge_valid: torch.Tensor,
+    min_valid_pixels: int = MIN_ALIGNMENT_PIXELS,
+    conf_quantile: float = ALIGNMENT_CONF_QUANTILE,
+) -> float | None:
+    """Solve the scale aligning MoGe depth to backbone depth.
+
+    All inputs are ``(h, w)``. The scale is ``exp(median(log(bb) - log(mo)))``
+    over pixels that are valid in both maps and in the top-``conf_quantile``
+    tail of backbone confidence, so it is robust to sky, outliers and the
+    backbone's confidence scale (Pi3 logits and VGGT/MapAnything scores alike;
+    uniform confidence keeps every eligible pixel).
+
+    Returns:
+        The scale, or ``None`` when fewer than ``min_valid_pixels`` pixels
+        support the fit.
+    """
+    backbone_depth = torch.as_tensor(backbone_depth)
+    backbone_conf = torch.as_tensor(backbone_conf)
+    moge_depth = torch.as_tensor(moge_depth)
+    moge_valid = torch.as_tensor(moge_valid, dtype=torch.bool)
+    eligible = (
+        moge_valid
+        & torch.isfinite(moge_depth)
+        & (moge_depth > 0)
+        & torch.isfinite(backbone_depth)
+        & (backbone_depth > 0)
+        & torch.isfinite(backbone_conf)
+    )
+    if int(eligible.sum()) < min_valid_pixels:
+        return None
+    cutoff = torch.quantile(backbone_conf[eligible].float(), conf_quantile)
+    support = eligible & (backbone_conf >= cutoff)
+    if int(support.sum()) < min_valid_pixels:
+        return None
+    log_ratio = torch.log(backbone_depth[support].float()) - torch.log(
+        moge_depth[support].float()
+    )
+    return float(torch.exp(torch.median(log_ratio)))
+
+
+class MoGe3DepthLocalInference(LocalInference):
+    """Replace backbone depth with scale-aligned MoGe-3 depth.
+
+    Poses, intrinsics and confidences pass through untouched. MoGe runs on the
+    backbone's exact canvas pixels cropped to each image's content box, so its
+    output aligns 1:1 with the backbone grid without resampling. Padding and
+    MoGe-invalid pixels keep backbone depth.
+    """
+
+    def __init__(
+        self, backbone: LocalInference, client: MoGe3WorkerClient
+    ) -> None:
+        super().__init__(backbone.model, backbone.device, backbone.dtype)
+        self.backbone = backbone
+        self.client = client
+
+    @torch.no_grad()
+    def predict(self, batch: dict) -> dict:
+        pred = self.backbone.predict(batch)
+        depth = pred["depth"]
+        images = batch["images"]
+        if (
+            depth.ndim != 5
+            or depth.shape[-1] != 1
+            or tuple(depth.shape[2:4]) != tuple(images.shape[-2:])
+        ):
+            raise ValueError(
+                "MoGe-3 depth replacement needs backbone depth at the input "
+                f"canvas resolution (B,N,H,W,1); got depth {tuple(depth.shape)}"
+                f" for images {tuple(images.shape)}"
+            )
+        b_count, n_count = images.shape[0], images.shape[1]
+        height, width = images.shape[-2], images.shape[-1]
+        out = depth[..., 0].float().clone()
+        conf = pred["depth_conf"]
+        if conf.ndim == 5 and conf.shape[-1] == 1:
+            conf = conf[..., 0]
+        images_change = batch["images_change"]
+        images_shape_ori = batch["images_shape_ori"]
+        image_paths = batch["image_paths"]
+        intrinsics = pred["intrinsics"]
+        groups: dict[tuple[int, int], list[tuple[int, int, int, int, str, float]]] = {}
+        for b in range(b_count):
+            for n in range(n_count):
+                change = images_change[b][n]
+                change = (
+                    change.tolist() if hasattr(change, "tolist") else list(change)
+                )
+                shape_ori = images_shape_ori[b][n]
+                shape_ori = (
+                    shape_ori.tolist()
+                    if hasattr(shape_ori, "tolist")
+                    else list(shape_ori)
+                )
+                x0, y0, w, h = content_box(
+                    change, shape_ori, (height, width)
+                )
+                key = str(image_paths[n][b])
+                fx = float(intrinsics[b][n][0][0])
+                if not math.isfinite(fx) or fx <= 0:
+                    logger.warning(
+                        f"MoGe-3 depth not aligned for {key}: invalid backbone"
+                        f" focal {fx}; keeping backbone depth"
+                    )
+                    continue
+                fov_x = math.degrees(2.0 * math.atan(w / (2.0 * fx)))
+                groups.setdefault((h, w), []).append((b, n, x0, y0, key, fov_x))
+        can_cuda = torch.cuda.is_available()
+        for (h, w), members in groups.items():
+            crops = np.stack(
+                [
+                    images[b, n, :, y0 : y0 + h, x0 : x0 + w]
+                    .float()
+                    .cpu()
+                    .numpy()
+                    for b, n, x0, y0, _, _ in members
+                ]
+            )
+            keys = [key for _, _, _, _, key, _ in members]
+            fovs = np.array(
+                [fov for _, _, _, _, _, fov in members], dtype=np.float64
+            )
+            if can_cuda:
+                torch.cuda.empty_cache()
+            moge_depths, moge_masks = self.client.infer_depth(keys, crops, fovs)
+            for (b, n, x0, y0, key, _), moge, valid in zip(
+                members, moge_depths, moge_masks
+            ):
+                out_box = out[b, n, y0 : y0 + h, x0 : x0 + w]
+                conf_box = conf[b, n, y0 : y0 + h, x0 : x0 + w]
+                moge_t = torch.from_numpy(np.ascontiguousarray(moge)).to(
+                    device=out.device, dtype=torch.float32
+                )
+                valid_t = torch.from_numpy(np.ascontiguousarray(valid)).to(
+                    out.device
+                )
+                scale = align_moge_depth(out_box, conf_box, moge_t, valid_t)
+                if scale is None:
+                    logger.warning(
+                        f"MoGe-3 depth not aligned for {key}; "
+                        "keeping backbone depth"
+                    )
+                    continue
+                out[b, n, y0 : y0 + h, x0 : x0 + w] = torch.where(
+                    valid_t, moge_t * scale, out_box
+                )
+        pred["depth"] = out.unsqueeze(-1)
+        return pred
